{
  "manifest_version": 3,
  "name": "Workspace Context Switcher",
  "version": "1.0.0",
  "description": "Save the current window's tabs as named workspaces and reopen any workspace in one click. Everything stays on your device.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workspace Context Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
