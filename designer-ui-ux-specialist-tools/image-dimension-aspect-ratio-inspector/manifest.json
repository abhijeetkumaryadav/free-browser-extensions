{
  "manifest_version": 3,
  "name": "Image Dimension & Aspect Ratio Inspector",
  "version": "1.0.0",
  "description": "Scan every image on the page: natural vs displayed dimensions, aspect ratio, lazy/broken status, and click-to-highlight.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}