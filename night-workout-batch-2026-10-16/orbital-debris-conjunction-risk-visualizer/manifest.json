{
  "manifest_version": 3,
  "name": "Conjunction Risk Visualizer",
  "version": "1.0.0",
  "description": "Educational conjunction-risk math demo. Simplified model \u2014 not a real collision assessment.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}