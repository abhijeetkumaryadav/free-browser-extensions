{
  "manifest_version": 3,
  "name": "Dual-Language SRT Muxer",
  "version": "1.0.0",
  "description": "Merge two SRT subtitle files into one dual-language SRT. 100% local — your files never leave the machine.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "minimum_chrome_version": "88"
}
